# Normalisasi akhir baris ke LF agar konsisten di Windows/Linux/macOS.
* text=auto eol=lf

# Source & konfigurasi teks
*.cpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.ino text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.php text eol=lf
*.ini text eol=lf

# Aset biner
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff2 binary
*.gif binary
*.ico binary